<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Activity_GameView">

    <View
            android:id="@+id/keyboardBackdrop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#808080"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBar_Loaded"
            app:layout_constraintBottom_toBottomOf="parent"/>

    <com.mizushiki.nicoflick_a.FlickInputEditText
            android:hint="フリック入力" tools:ignore="TouchTargetSizeCheck"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:text=""
            android:id="@+id/editText"
            app:layout_constraintBottom_toBottomOf="@+id/playerView"
            app:layout_constraintEnd_toEndOf="@+id/playerView" app:layout_constraintStart_toStartOf="@+id/playerView"
            app:layout_constraintTop_toTopOf="@+id/playerView"/>
    <View
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:id="@+id/mekakushiView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/playerView"
            android:background="#FFF"/>
    <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="300dp" app:layout_constraintTop_toTopOf="parent"
            app:use_controller="false"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintVertical_bias="0.0"
            android:background="@android:color/background_dark">
    </com.google.android.exoplayer2.ui.PlayerView>
    <com.mizushiki.nicoflick_a.DecolationLabel
            android:layout_width="0dp"
            android:layout_height="wrap_content" android:id="@+id/textView_HighScore"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toTopOf="@+id/notesWindow" app:layout_constraintStart_toStartOf="@+id/playerView"
            android:textSize="10sp" app:layout_constraintEnd_toEndOf="@+id/playerView"
            android:layout_marginStart="8dp" android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            app:stroke_size="6"
            app:stroke_color="#000000" />
    <com.mizushiki.nicoflick_a.DecolationLabel
            android:layout_width="0dp"
            android:layout_height="wrap_content" android:id="@+id/textView_Score"
            app:layout_constraintEnd_toEndOf="@+id/playerView" app:layout_constraintTop_toTopOf="@+id/notesWindow"
            app:layout_constraintStart_toStartOf="@+id/playerView" android:textAlignment="viewEnd"
            android:layout_marginTop="8dp" android:layout_marginEnd="8dp"
            android:textColor="@android:color/white"
            app:stroke_size="6"
            app:stroke_color="#000000" />
    <com.mizushiki.nicoflick_a.DecolationLabel
            android:layout_width="0dp"
            android:layout_height="wrap_content" android:id="@+id/textView_judgeOffset"
            app:layout_constraintBottom_toBottomOf="@+id/playerView"
            app:layout_constraintEnd_toEndOf="@+id/playerView" app:layout_constraintStart_toStartOf="@+id/playerView"
            android:textSize="8sp" android:textAlignment="viewEnd"
            android:textColor="#929292"
            app:stroke_size="6"
            app:stroke_color="#000000"/>
    <com.mizushiki.nicoflick_a.DecolationLabel
            android:text="@string/_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/button_Menu"
            app:layout_constraintTop_toBottomOf="@+id/playerView" app:layout_constraintEnd_toEndOf="@+id/playerView"
            android:minWidth="32dp"
            android:minHeight="48dp"
            android:layout_marginRight="20dp"
            android:textSize="12sp" app:layout_constraintBottom_toTopOf="@+id/noteBarView"
            android:onClick="menuButton" android:textAlignment="viewEnd"
            android:textColor="#000000"
            app:stroke_size="6"
            app:stroke_color="#CCFFFFFF" />
    <View
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:id="@+id/noteBarView" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/playerView"
            android:layout_marginTop="32dp" android:background="#E9FDBB"/>

    <ImageView
            android:src="@drawable/dot_circle"
            android:layout_width="36dp"
            android:layout_height="36dp" android:id="@+id/dotCircle"
            app:layout_constraintBottom_toBottomOf="@+id/noteBarView"
            app:layout_constraintTop_toTopOf="@+id/noteBarView"
            app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.4" android:visibility="invisible"/>
    <ImageView
            android:src="@drawable/circle"
            android:layout_width="40dp"
            android:layout_height="40dp" android:id="@+id/flickCircle"
            app:layout_constraintBottom_toBottomOf="@+id/noteBarView"
            app:layout_constraintTop_toTopOf="@+id/noteBarView"
            app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.0"/>

    <com.mizushiki.nicoflick_a.DecolationLabel android:id="@+id/textView_Great1" android:text="@string/great" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintBottom_toTopOf="@+id/noteBarView" android:layout_marginBottom="8dp" app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.0" android:textColor="#FF0080" app:stroke_size="4" app:stroke_color="#CCFFFFFF" app:stroke_shadow_x="3" app:stroke_shadow_y="3" app:stroke_shadow_color="#80FFFFFF"/>

    <com.mizushiki.nicoflick_a.DecolationLabel android:id="@+id/textView_Good1" android:text="@string/good" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintBottom_toTopOf="@+id/noteBarView" android:layout_marginBottom="8dp" app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.0" android:textColor="#0080FF" app:stroke_size="4" app:stroke_color="#CCFFFFFF" app:stroke_shadow_x="3" app:stroke_shadow_y="3" app:stroke_shadow_color="#80FFFFFF"/>

    <com.mizushiki.nicoflick_a.DecolationLabel android:id="@+id/textView_Safe1" android:text="@string/safe" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintBottom_toTopOf="@+id/noteBarView" android:layout_marginBottom="8dp" app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.0" android:textColor="#80FF00" app:stroke_size="4" app:stroke_color="#CCFFFFFF" app:stroke_shadow_x="3" app:stroke_shadow_y="3" app:stroke_shadow_color="#80FFFFFF"/>

    <com.mizushiki.nicoflick_a.DecolationLabel android:id="@+id/textView_Bad1" android:text="@string/bad" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintBottom_toTopOf="@+id/noteBarView" android:layout_marginBottom="8dp" app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.0" android:textColor="#808000" app:stroke_size="4" app:stroke_color="#CCFFFFFF" app:stroke_shadow_x="3" app:stroke_shadow_y="3" app:stroke_shadow_color="#80FFFFFF"/>

    <com.mizushiki.nicoflick_a.DecolationLabel android:id="@+id/textView_Miss1" android:text="@string/miss" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintBottom_toTopOf="@+id/noteBarView" android:layout_marginBottom="8dp" app:layout_constraintStart_toStartOf="@+id/noteBarView" android:alpha="0.0" android:textColor="#400080" app:stroke_size="4" app:stroke_color="#CCFFFFFF" app:stroke_shadow_x="3" app:stroke_shadow_y="3" app:stroke_shadow_color="#80FFFFFF"/>

    <TextView
            android:text="X"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/textView_BarWord"
            app:layout_constraintBottom_toBottomOf="@+id/noteBarView"
            app:layout_constraintTop_toTopOf="@+id/noteBarView"
            android:textSize="28sp" app:layout_constraintStart_toEndOf="parent"/>
    <com.mizushiki.nicoflick_a.DecolationLabel
            android:text="99 combo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/textView_combo"
            android:textStyle="bold|italic"
            android:visibility="invisible"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/noteBarView"
            app:layout_constraintStart_toStartOf="@+id/textView_Great1" android:layout_marginBottom="4dp"
            android:textColor="#333333"
            app:stroke_size="6"
            app:stroke_color="#CCFFFFFF" />
    <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="1000"
            android:id="@+id/progressBar"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/noteBarView"
            android:layout_marginBottom="10dp"
            android:progress="500"
            android:progressTint="@android:color/holo_blue_dark" android:layout_marginStart="96dp"
            android:layout_marginEnd="96dp"
            android:alpha="0.01"
    />
    <ProgressBar
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="1000"
            android:id="@+id/progressBar2"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/noteBarView"
            android:layout_marginTop="25dp"
            android:progress="500"
            android:progressTint="@android:color/holo_blue_dark" android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:alpha="0.01"
    />
    <ProgressBar
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:id="@+id/progressBar_Loaded"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playerView" android:progressTint="?attr/colorButtonNormal"
            android:progressBackgroundTint="@color/design_default_color_background"/>
    <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:id="@+id/progressBar_Played" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/playerView"
            android:progressTint="@android:color/holo_blue_dark"
            android:progressBackgroundTint="@color/design_default_color_background" android:max="100000"/>

    <FrameLayout
        android:id="@+id/notesWindow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp"></FrameLayout>

    <!-- 背景なしで動画に重ねる。menuとの間隔はpractice_controls_menu_gapで調整する。 -->
    <LinearLayout android:id="@+id/practiceControls" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone"
        android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        android:layout_marginBottom="@dimen/practice_controls_menu_gap"
        app:layout_constraintBottom_toTopOf="@id/button_Menu"
        app:layout_constraintStart_toStartOf="@id/playerView" app:layout_constraintEnd_toEndOf="@id/playerView">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Switch android:id="@+id/practiceAutoPlay" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:background="@null"
                android:contentDescription="練習のオートプレイ" />
            <com.mizushiki.nicoflick_a.DecolationLabel android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text=": Auto"
                android:layout_marginStart="4dp" android:textSize="14sp" android:textColor="#000000"
                app:stroke_size="4" app:stroke_color="#FFFFFF" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <com.mizushiki.nicoflick_a.DecolationLabel android:id="@+id/practiceRateLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="× 1.0" android:textSize="14sp" android:textColor="#000000"
                app:stroke_size="4" app:stroke_color="#FFFFFF" />
            <SeekBar android:id="@+id/practiceRatebar" android:layout_width="0dp"
                android:layout_weight="2" android:layout_height="match_parent"
                android:background="@null" android:contentDescription="練習の再生速度" />
        </LinearLayout>
        <SeekBar android:id="@+id/practiceSeekbar" android:layout_width="match_parent"
            android:layout_height="48dp" android:background="@null"
            android:contentDescription="練習の再生位置" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
